# Files in the repo that must NOT be uploaded as public site assets.
# The built /islands/*.js bundles ARE served; their source toolchain is not.
#
# Directory patterns are anchored with a leading slash. These are gitignore
# rules, so an unanchored `docs/` matches a directory of that name at *any*
# depth — which silently excluded assets/docs/ too, and the site atlas linked
# from /initiatives/paititi-biocultural-reserve had been 404ing because of it.
/islands-src/
/docs/
.git/
.gitignore
.assetsignore
wrangler.jsonc
README.md
.wrangler/
/tools/
server.js
api.js
worker.js
package.json
package-lock.json

# Internal planning docs. Both were being served publicly — build-spec.md
# quotes Roman's WhatsApp messages and lists open blockers, and nothing on the
# site links to either.
build-spec.md
website-redo-spec.pdf

# Blog source for tools/migrate_blog.py, build-time only. data/products.json
# is NOT excluded: api.js fetches it through env.ASSETS at runtime.
/data/blog/

# Scratch probe harnesses. Untracked, but `wrangler deploy` uploads the folder
# rather than the commit, so anything left lying here would be served.
_probe*.html

# Held back, 28 Aug 2026. The Living Wisdom School introduction is finished and
# kept in the repo, but must not reach the live site yet — Roman wants to settle
# how it is introduced first. Anchored with a leading slash: an unanchored name
# would match at any depth (see the note at the top of this file).
/LivingWisdomSchool.dc.html
/LivingWisdomSchool.es.dc.html
